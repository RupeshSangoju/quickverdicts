NODE_ENV=development
PORT=5000

# Frontend allowed origin
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Microservice URLs (defaults to localhost for local dev)
AUTH_SERVICE_URL=http://localhost:5001
NOTIFICATION_SERVICE_URL=http://localhost:5002
PAYMENT_SERVICE_URL=http://localhost:5003
CASE_SERVICE_URL=http://localhost:5004
TRIAL_SERVICE_URL=http://localhost:5005
WAR_ROOM_SERVICE_URL=http://localhost:5006
VERDICT_SERVICE_URL=http://localhost:5007
ATTORNEY_SERVICE_URL=http://localhost:5008
JUROR_SERVICE_URL=http://localhost:5009
ADMIN_SERVICE_URL=http://localhost:5010

# Monolith fallback (not-yet-migrated routes: /api/files, /api/recordings, /api/diagnostic)
MONOLITH_URL=http://localhost:4000

# Rate limits
RATE_LIMIT_MAX=500
