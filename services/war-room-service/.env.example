NODE_ENV=development
PORT=5006

# Database
DB_SERVER=your-sql-server
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# JWT (must match auth-service)
JWT_SECRET=your-jwt-secret-min-32-chars

# Azure Blob Storage (for documents and evidence)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=warroom-documents

# Azure Communication Services (for trial meeting creation)
ACS_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=...

# Email
EMAIL_USER=your-email@example.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# URLs
FRONTEND_URL=http://localhost:3000
GATEWAY_URL=http://localhost:5000
ALLOWED_ORIGINS=

# Inter-service
NOTIFICATION_SERVICE_URL=http://localhost:5002
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-secret

# Rate limits
RATE_LIMIT_MAX=300
